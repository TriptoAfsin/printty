# Copy to printty.env (next to printty.exe, or in the data folder) and fill in.
# printty.env is gitignored: never commit real values.

# Where Printty listens. Phones on the Wi-Fi use http://<this PC's name or IP>:8631
PRINTTY_ADDR=:8631

# Data folder (default: C:\ProgramData\Printty on Windows)
# PRINTTY_DATA_DIR=

# Telegram alerts: a bot token from @BotFather and your chat ID(s), comma-separated.
# Use a bot that no other app uses, so Approve/Reject work inside Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base URL used in alert links, e.g. https://my-pc.tail1234.ts.net:8631
# PRINTTY_PUBLIC_URL=

# HTTPS (needed to install the app and use the phone share sheet)
# PRINTTY_TLS_CERT=
# PRINTTY_TLS_KEY=

# PRINTTY_MAX_UPLOAD_MB=50
